NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:4000
VITE_API_URL=http://localhost:3000
VITE_DEMO_MODE=false
EXEC_MODE=docker
RUNNER_IMAGE=seeplusplus-runner:local
RUNNER_TIMEOUT_MS=10000
RUNNER_MEMORY_MB=512
RUNNER_MAX_STEPS=1000
RUNNER_MAX_OUTPUT_BYTES=65536
RUNNER_MAX_SOURCE_BYTES=65536
RUNNER_CONCURRENCY=2
DATABASE_URL=postgresql://seeplusplus:seeplusplus@postgres:5432/seeplusplus
TRACE_CACHE_DIR=/data/traces
LOG_LEVEL=info
